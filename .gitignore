# Dependencies and package-manager caches
node_modules/
.npm-cache/
.pnpm-store/
.pnp
.pnp.*
.yarn/

# Private environment and credentials
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*
*.pem
*.key
*.p12
*.pfx
*credentials*.json
*secrets*.json

# Generated app output; /build contains required vendored source
/.next/
/.vinext/
/dist/
/out/
*.tsbuildinfo
/coverage/
/test-output/
/playwright-report/
/test-results/

# Hosting and development runtime state
/.wrangler/
/.sites-runtime/
/.vercel/
/.netlify/
/.openai/*
!/.openai/hosting.json
/.agents/
/.codex/
/.codex-remote-attachments/
/.sites-tools/

# Local databases, backups, generated reports, and private work
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
*.sql.gz
*.dump
*.bak
*.backup
/outputs/
/work/
/design/
/private/
/backups/
/OLWIF-README.md
/START-OLWIF.cmd

# Logs and operating-system files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.DS_Store
Thumbs.db
Desktop.ini
