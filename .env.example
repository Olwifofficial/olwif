# Runtime configuration. Never put real secrets in this example.
ADMIN_EMAIL=owner@example.com
SITE_ORIGIN=http://localhost:5173
# Owner authentication is disabled by default. Set true only behind a verified
# proxy that strips incoming identity headers and injects authenticated values,
# or for the loopback-only local mock described in README.md. Never expose that mock.
OLWIF_TRUSTED_AUTH_PROXY=false
# Optional: fine-grained read-only GitHub credential, stored as a Sites secret.
GITHUB_TOKEN=
# Optional: free Tavily account only; no card, pay-as-you-go, or paid plan.
# Keep this server-side and private. Never prefix it with NEXT_PUBLIC_ or VITE_.
# Read FREE-RESEARCH.md before configuring; no key means public-page reading only.
TAVILY_API_KEY=
# Only populate after independently verifying this key's free account has
# pay-as-you-go and auto upgrades disabled. SHA-256 of that exact key; not a key.
# Needed only when Tavily reports a null PAYG cap; changing the key invalidates it.
TAVILY_FREE_ONLY_KEY_SHA256=
# Enable only after deploying and verifying the scheduled handler on a free-tier host.
# Local preview uses manual watchlist checks, with no background process.
OLWIF_BACKGROUND_MONITORING=false
